# ═══════════════════════════════════════════════════════
# BodySense Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ──────────────────
DB_HOST=127.0.0.1
DB_PORT=20110
DB_NAME=bodysense
DB_USER=bodysense
DB_PASSWORD=bodysense123
DB_SSLMODE=disable

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=20111
REDIS_PASSWORD=bodysense123

# ── Go API Service ────────────────────────────────────
API_PORT=20101
API_HOST=127.0.0.1
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TTL_HOURS=0.25
JWT_REFRESH_TTL_HOURS=720
CORS_ORIGINS=http://localhost:20100,http://127.0.0.1:20100
# Optional comma-separated hostnames accepted by the Vite dev server (for example a Tailscale MagicDNS name).
BODYSENSE_ALLOWED_HOSTS=
TRUSTED_PROXIES=127.0.0.1,::1

# ── Model Gateway (LiteLLM) ───────────────────────────
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.97.0
LITELLM_PORT=20112
LITELLM_MASTER_KEY=sk-bodysense-dev-gateway
# Physical LLM provider credentials are read only by litellm-gateway.
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=sk-your-mimo-api-key-here
OPENROUTER_API_KEY=sk-your-openrouter-api-key-here
GROQ_API_KEY=gsk-your-groq-api-key-here
# Host-side tools may point at the same internal gateway explicitly.
LITELLM_BASE_URL=http://127.0.0.1:20112/v1
LITELLM_API_KEY=sk-bodysense-dev-gateway

# ── Agent deployment pointers (Go API) ───────────────
TREATMENT_AGENT_CONFIGURATION_ID=treat-config-85718f8e90ac9d80

# ── AI Service (Python) ──────────────────────────────
AI_SERVICE_PORT=20102

# Embedding 配置
# 默认走本地模型，便于离线完成视频知识入库
# 推荐默认值：完全离线、零模型下载的 hashing embedding
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=1536

# 可选增强：如果你希望更好的语义效果，可以切到本地 transformer 模型
# EMBEDDING_PROVIDER=local_transformer
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 可选：Embedding 如需改用 OpenAI-compatible 服务，仅配置 Embedding 专用凭据。
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.example.com/v1

# ── ASR (视频转录) ───────────────────────────────────
# Provider: whisper.cpp | funasr_sensevoice | asr_api
ASR_PROVIDER=whisper.cpp

# whisper.cpp 模型 (tiny/base/small)
ASR_WHISPER_MODEL=ggml-base.bin

# FunASR 模型
# ASR_FUNASR_MODEL=sensevoice-small-q8.gguf

# ASR API (当 ASR_PROVIDER=asr_api 时生效)
# 支持任何 OpenAI-compatible 音频转录接口 (MiMo, OpenAI, LocalAI 等)
# ASR_API_KEY=${OPENAI_API_KEY}
# ASR_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# ASR_API_MODEL=mimo-v2.5-asr

# ── 知识切分 ─────────────────────────────────────────
# Provider: heuristic (关键词规则，默认) | llm (LLM 语义切分)
SPLITTER_PROVIDER=heuristic

# ── AI Service URL (for Go backend to proxy) ─────────
AI_SERVICE_URL=http://localhost:20102

# ── Frontend (React/Vite) ────────────────────────────
BODYSENSE_WEB_PORT=20100
VITE_DEV_API_TARGET=http://127.0.0.1:20101
VITE_WS_URL=ws://localhost:20101/ws
# 3D anatomy catalog seam. Staging/production Web images force the matching
# BodySense-controlled path from BODYSENSE_ANATOMY_ATLAS_VERSION at build time.
# Direct dev can use this path after running scripts/anatomy/sync.mjs locally.
BODYSENSE_ANATOMY_ATLAS_VERSION=1.4.0
# Optional absolute base for immutable Vite build assets. Keep empty for same-origin dev/staging.
# Production/CDN form: https://assets.bakersean.top/web/<full-git-revision>/
VITE_ASSET_BASE=
VITE_BODYSENSE_ANATOMY_CATALOG_URL=/static/anatomy/vanatome/1.4.0/releases/1.4.0/catalog.json

# ── Docker Registry (production only) ─────────────────
REGISTRY=ghcr.io/your-org
WEB_TAG=prod-latest
API_TAG=prod-latest
AI_TAG=prod-latest

# ── Off-host PostgreSQL backup (BS-PROD-012) ──────────
# Operator-owned daily custom-format dumps (pg_dump -Fc) uploaded to a private
# OSS/S3-compatible destination with host-only least-privilege credentials.
# Secret AccessKey/SecretKey live separately in .env.production.local:
#   OFFHOST_BACKUP_ACCESS_KEY=
#   OFFHOST_BACKUP_SECRET_KEY=
# Restore drills (scripts/restore-production-backup.sh) restore only into an
# explicitly disposable PostgreSQL container on its own drill network with the
# labels bodysense.restore-project=<target-project>/bodysense.disposable-restore=yes;
# the drill network itself must contain no production container (Docker bridge
# connectivity is bidirectional), so validators run in SEPARATE disposable
# validator containers derived from the resolved api container's Config.Image
# (pin OFFHOST_VALIDATOR_IMAGE to override) and attached only to the drill
# network — the production api container is never joined to the drill network;
# the target database password reaches the validators only via PGPASSWORD
# (docker: --env-file; golang: inherited), never via argv or -database-url.
OFFHOST_BACKUP_ENABLED=true
OFFHOST_BACKUP_BUCKET=bodysense-db-backup
OFFHOST_BACKUP_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OFFHOST_BACKUP_REGION=cn-hangzhou
OFFHOST_BACKUP_PREFIX=bodysense/postgres
OFFHOST_BACKUP_URL_STYLE=path
OFFHOST_BACKUP_RETENTION_DAYS=30
OFFHOST_BACKUP_FRESHNESS_HOURS=30
OFFHOST_BACKUP_FRESHNESS_PROBE=object
# Object-level encryption and ACL on newly uploaded backup objects. The backup
# always runs a fail-closed private-destination preflight (the bucket ACL must
# be provably private) before the first upload. SSE on PutObject: AES256 or
# aws:kms, or leave empty to send no SSE header (only allowed when the bucket
# already has server-side encryption configured; the preflight still requires a
# private bucket ACL). The client refuses any object ACL other than private.
OFFHOST_BACKUP_OBJECT_ACL=private
OFFHOST_BACKUP_SSE=AES256
# Destination-privacy proof mode. Default acl+policy (strongest): the backup
# fails closed unless the bucket ACL is readable+private AND GetBucketPolicyStatus
# (IsPublic=true) is not a public answer — a store that cannot answer
# (BucketPolicyStatusUnsupported/BucketPolicyStatusFailed/BucketPolicyStatusDenied)
# or answers malformed also fails the preflight. Set
# OFFHOST_BACKUP_PRIVACY_PROOF=acl to opt into ACL-only proof for stores that do
# not implement GetBucketPolicyStatus at all, such as Alibaba OSS (the client
# prints "OFFHOST_S3_WARNING policy status is NOT verified (acl-only proof)" on
# every run and uses the provably-private bucket ACL as the only machine-verified
# privacy proof). Never read "no policy status answer" as "private".
OFFHOST_BACKUP_PRIVACY_PROOF=acl+policy
# While OFFHOST_BACKUP_ENABLED!=true the scheduled freshness check exits non-zero
# with reason=backups-disabled (the alert path must fire — a disabled pipeline
# never masquerades as protected). OFFHOST_BACKUP_MAINTENANCE_SUPPRESS=true
# acknowledges an intentional maintenance window with a clean exit.
OFFHOST_BACKUP_MAINTENANCE_SUPPRESS=false
# Optional: command run (via bash -c) when the freshness check fails, with
# OFFHOST_BACKUP_FRESH=FAIL and reason=/age_hours=/threshold_hours= exported.
# OFFHOST_BACKUP_ALERT_CMD=/usr/local/bin/offhost-backup-alert
# Restore: when production is down, a restore drill needs no live production
# container. OFFHOST_RECOVERY_MODE=true (or --recovery-mode=yes) skips ONLY the
# production-side proofs (container-id difference, shared-network intersection,
# discovered Compose project) and is strictly weaker isolation evidence; every
# target-side proof (dedicated network, no published ports, disposable-restore
# labels, non-host/non-none network mode, compose-project label differing from
# the declared production project) still applies. OFFHOST_RECOVERY_PRODUCTION_PROJECT
# names the production compose project; default "bodysense".
# OFFHOST_RECOVERY_MODE=false
# OFFHOST_RECOVERY_PRODUCTION_PROJECT=bodysense
# Optional restore knob: pin the disposable validator image explicitly
# (default: derived from the resolved api container's Config.Image).
# OFFHOST_VALIDATOR_IMAGE=registry.example.com/bodysense-api:prod-latest

# ── AI Service Features ──────────────────────────────
# 启用 ask_user HITL 工具（AI 可暂停流程向用户提问）
ASK_USER_ENABLED=false

# ── GitHub MCP (for AI agent) ─────────────────────────
GITHUB_TOKEN=ghp_your-github-token-here
