# ═══════════════════════════════════════════════════════
# BodySense Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ──────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bodysense
DB_USER=bodysense
DB_PASSWORD=bodysense123

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6384
REDIS_PASSWORD=bodysense123

# ── Go API Service ────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TTL_HOURS=168
JWT_REFRESH_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173

# ── AI Service (Python) ──────────────────────────────
AI_SERVICE_PORT=8100

# Embedding 配置
# 默认走本地模型，便于离线完成视频知识入库
# 推荐默认值：完全离线、零模型下载的 hashing embedding
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=384

# 可选增强：如果你希望更好的语义效果，可以切到本地 transformer 模型
# EMBEDDING_PROVIDER=local_transformer
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 可选：如需改用 OpenAI 兼容服务，再填写下面配置
OPENROUTER_API_KEY=sk-your-openrouter-api-key-here
LLM_PROVIDER=openrouter
LLM_API_KEY=${OPENROUTER_API_KEY}
LLM_MODEL=openai/gpt-oss-120b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=${OPENROUTER_API_KEY}
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# 本地视频入库 / ASR
WHISPER_MODEL=ggml-base.bin

# ── AI Service URL (for Go backend to proxy) ─────────
AI_SERVICE_URL=http://localhost:8100

# ── Frontend (React/Vite) ────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ── Docker Registry (production only) ─────────────────
REGISTRY=ghcr.io/your-org
WEB_TAG=prod-latest
API_TAG=prod-latest
AI_TAG=prod-latest

# ── GitHub MCP (for AI agent) ─────────────────────────
GITHUB_TOKEN=ghp_your-github-token-here
