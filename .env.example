# ═══════════════════════════════════════════════════════
# BodySense Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bodysense
DB_USER=bodysense
DB_PASSWORD=bodysense123

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6384
REDIS_PASSWORD=bodysense123

# ── Go API Service ────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TTL_HOURS=168
JWT_REFRESH_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173

# ── AI Service (Python) ──────────────────────────────
AI_SERVICE_PORT=8100
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-llm-api-key-here
LLM_MODEL=qwen-plus
OPENAI_API_KEY=sk-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── AI Service URL (for Go backend to proxy) ─────────
AI_SERVICE_URL=http://localhost:8100

# ── Frontend (React/Vite) ────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ── Docker Registry (production only) ─────────────────
REGISTRY=ghcr.io/your-org
WEB_TAG=prod-latest
API_TAG=prod-latest
AI_TAG=prod-latest

# ── GitHub MCP (for AI agent) ─────────────────────────
GITHUB_TOKEN=ghp_your-github-token-here
