[Unit]
Description=BodySense slim staging candidate deploy check (memory-guarded)
Documentation=file:///opt/bodysense-staging/repo/docs/runbooks/staging-slim.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/bodysense-staging/bin/bodysense-staging-slim-watch
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
