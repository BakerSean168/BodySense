[Unit]
Description=BodySense coherent ACR release deploy check
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=BODYSENSE_DEPLOY_ROOT=/opt/bodysense
ExecStart=/opt/bodysense/scripts/production-deploy-watch.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
