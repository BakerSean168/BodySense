[Unit]
Description=BodySense off-host PostgreSQL backup freshness check
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=BODYSENSE_DEPLOY_ROOT=/opt/bodysense
ExecStart=/opt/bodysense/scripts/production-postgres-dr.sh status
TimeoutStartSec=900
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
