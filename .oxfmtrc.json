{
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/dist/**",
    "**/storybook-static/**",
    "**/coverage/**",
    "**/generated/**",
    "apps/web/public/static/anatomy/vanatome/**",
    "pnpm-lock.yaml",
    "**/*.generated.json",
    "**/*.md",
    "docs/**",
    "apps/api/**",
    "apps/ai-service/**",
    "tools/contracts/**",
    "**/fixtures/**",
    "**/testdata/**",
    "showcase/**",
    ".release-please-manifest.json",
    "postman/**"
  ],
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
