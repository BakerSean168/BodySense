# ═══════════════════════════════════════════════════════
# BodySense 生产环境配置 (非敏感)
# =============================================================================
# 本文件包含生产环境的非敏感配置，可以提交到 Git。
# 敏感信息 (密码、密钥) 放在 .env.production.local 中，不提交 Git。
#
# 加载优先级：
#   1. .env (基础共享配置)
#   2. .env.production (本文件 ← 生产非敏感配置)
#   3. .env.production.local (生产敏感信息，不提交 Git)
#   4. 操作系统环境变量 (最高优先级)
# =============================================================================

# ── 应用基础配置 ──────────────────────────────────────
NODE_ENV=production
TZ=Asia/Shanghai

# ── Docker 镜像配置 ────────────────────────────────────
REGISTRY=crpi-cv97phwhms6wy4as.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=bodysense
WEB_TAG=prod-latest
API_TAG=prod-latest
AI_TAG=prod-latest
RUNTIME_TAG=prod-latest

# ── Caddy / production deploy watcher ─────────────────
APP_DOMAIN=body.bakersean.top
ACME_EMAIL=admin@bakersean.top
AUTO_DEPLOY_ENABLED=true

# ── 数据库配置 (PostgreSQL + pgvector) ───────────────
# DB_PASSWORD 必须在 .env.production.local 中设置！
DB_HOST=postgres                              # Docker 网络中的 PostgreSQL 服务名
DB_PORT=5432
DB_NAME=bodysense
DB_USER=bodysense
POSTGRES_MAJOR=18
POSTGRES_DATA_VOLUME=bodysense-postgres-pg18

# ── Redis 配置 ───────────────────────────────────────
# REDIS_PASSWORD 必须在 .env.production.local 中设置！
REDIS_HOST=redis                              # Docker 网络中的 Redis 服务名
REDIS_PORT=6379

# ── Go API 配置 ──────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
JWT_ACCESS_TTL_HOURS=0.25                      # Access token 有效期 15 分钟（短时效，配合 session 撤销）
JWT_REFRESH_TTL_HOURS=720                     # Refresh token 有效期 30 天
# JWT_SECRET_KEY 必须在 .env.production.local 中设置！
CORS_ORIGINS=https://body.bakersean.top    # 生产环境允许的前端来源
TRUSTED_PROXIES=172.16.0.0/12             # 仅信任 Docker 内部反向代理网段提供的 X-Forwarded-For

# ── Model Gateway (LiteLLM; production authority) ─────
LITELLM_IMAGE=${REGISTRY}/${ACR_NAMESPACE}/litellm:v1.97.0
LITELLM_PORT=4000
# LITELLM_MASTER_KEY / provider keys live only in .env.production.local.

# ── AI Service 配置 (Python/FastAPI) ────────────────
AI_SERVICE_PORT=8100
EMBEDDING_PROVIDER=hashing                    # 默认离线 hashing embedding
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY 必须在 .env.production.local 中设置！
# EMBEDDING_API_KEY 同 OPENROUTER_API_KEY，在 .env.production.local 中设置
WHISPER_MODEL=ggml-base.bin

# ── AI Service URL (Go 后端代理) ─────────────────────
AI_SERVICE_URL=http://ai-service:8100

# ── 离站数据库备份 (BS-PROD-012) ──────────────────────
# 每日经 docker compose exec pg_dump -Fc 生成自定义格式归档，连同 SHA-256 与
# 元数据上传至对象存储（阿里云 OSS / S3 兼容）。凭据只存在于
# .env.production.local（OFFHOST_BACKUP_ACCESS_KEY / OFFHOST_BACKUP_SECRET_KEY），
# 仅授予对备份桶的最小权限（PutObject/GetObject/DeleteObject/ListBucket +
# GetBucketAcl；GetBucketPolicyStatus 仅在 acl+policy 证明模式下需要）。
OFFHOST_BACKUP_ENABLED=false
OFFHOST_BACKUP_BUCKET=bodysense-db-backup
OFFHOST_BACKUP_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OFFHOST_BACKUP_REGION=cn-hangzhou
OFFHOST_BACKUP_PREFIX=bodysense/postgres
OFFHOST_BACKUP_URL_STYLE=path
OFFHOST_BACKUP_RETENTION_DAYS=30
OFFHOST_BACKUP_FRESHNESS_HOURS=30
OFFHOST_BACKUP_FRESHNESS_PROBE=object
# 上传对象上的对象级 ACL 与加密。每次备份在首次上传前都会执行 fail-closed
# 私有桶预检（必须证明桶 ACL 为私有）。PutObject 的 SSE：AES256 或 aws:kms；
# 留空表示不发送 SSE 头（仅当桶已配置默认服务端加密时允许；预检仍要求桶为
# 私有）。客户端拒绝 private 以外的任何对象 ACL。
OFFHOST_BACKUP_OBJECT_ACL=private
OFFHOST_BACKUP_SSE=AES256
# 目的地私有性证明模式。默认 acl+policy（最强）同时 fail-closed 验证桶 ACL 与
# GetBucketPolicyStatus；OSS 不实现该项（GetBucketPolicyStatus / ?policyStatus
# 是 AWS 专用接口），因此本生产环境显式选择 acl-only 证明：以机器可验证的桶
# ACL 作为唯一私有性证明，客户端每次打印
# "OFFHOST_S3_WARNING policy status is NOT verified (acl-only proof)" 警告。
# 不要在任何不支持 policy status 的存储上使用 acl+policy —— 未回答的 policy
# 状态永远不被当作“私有”。
OFFHOST_BACKUP_PRIVACY_PROOF=acl
# 备份管线禁用时的维护窗口开关：OFFHOST_BACKUP_ENABLED!=true 时，周期性新鲜度
# 检查默认以 reason=backups-disabled 非零退出（告警路径必须触发）；仅当显式
# 设置 OFFHOST_BACKUP_MAINTENANCE_SUPPRESS=true 时才以“intentionally
# suppressed”干净退出，表示有意的维护窗口。
OFFHOST_BACKUP_MAINTENANCE_SUPPRESS=false
# 新鲜度告警失败时运行的可选命令（见 runbook）。例如：
# OFFHOST_BACKUP_ALERT_CMD="/usr/local/bin/offhost-backup-alert"
# 恢复：当生产环境宕机时，恢复演练无需在线生产容器。OFFHOST_RECOVERY_MODE=true
# （或 --recovery-mode=yes）只跳过生产侧证明（容器 ID 差异、共享网络交集、
# 自动发现的 Compose 项目），是严格更弱的隔离证据；所有目标侧证明（专用网络、
# 无主机端口发布、disposable-restore 标签、非 host/none 网络模式、compose-project
# 标签与声明的生产项目不同）仍然适用。OFFHOST_RECOVERY_PRODUCTION_PROJECT 指定
# 生产 compose 项目名，默认 "bodysense"。
# OFFHOST_RECOVERY_MODE=false
# OFFHOST_RECOVERY_PRODUCTION_PROJECT=bodysense
# ═══════════════════════════════════════════════════════
# 生产运维入口
# ═══════════════════════════════════════════════════════
#
# 首次服务器初始化：
#   sudo ./scripts/setup-server.sh
#
# 后续发布由 systemd timer 自动检查 coherent prod-latest release：
#   systemctl status bodysense-deploy-watch.timer
#   journalctl -u bodysense-deploy-watch.service -n 100
#
# 手动只检查候选版本（不部署）：
#   /opt/bodysense/scripts/production-deploy-watch.sh --check-only
#
# 手动执行同一套受控部署门：
#   /opt/bodysense/scripts/production-deploy-watch.sh --force
# ═══════════════════════════════════════════════════════

# ── Off-host PostgreSQL disaster recovery ───────────────
# The DR runner is ops-only and is not started with the normal service set.
# Production authentication should use an ECS RAM role with least-privilege
# access to one private OSS bucket/prefix. Bucket/role names are host-specific
# and therefore live in .env.production.local.
DR_ENABLED=false
DR_OBJECT_STORE_DRIVER=oss
DR_OSS_REGION=cn-hangzhou
DR_OSS_USE_INTERNAL_ENDPOINT=true
DR_OSS_CREDENTIAL_TYPE=ecs_ram_role
DR_OSS_PREFIX=bodysense/production/postgres
DR_OSS_SERVER_SIDE_ENCRYPTION=AES256
DR_MAX_BACKUP_AGE_HOURS=30

# ── Private user upload storage ─────────────────────────
# Keep local until the private OSS bucket + ECS RAM role are provisioned and
# the explicit local->oss migration/cutover verification succeeds.
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_LOCAL_ROOT=/app/uploads
UPLOAD_OSS_REGION=cn-hangzhou
UPLOAD_OSS_USE_INTERNAL_ENDPOINT=true
UPLOAD_OSS_CREDENTIAL_TYPE=ecs_ram_role
UPLOAD_OSS_PREFIX=bodysense/production/uploads
UPLOAD_OSS_SERVER_SIDE_ENCRYPTION=AES256
# Host-specific UPLOAD_OSS_BUCKET / UPLOAD_OSS_ECS_RAM_ROLE live in .env.production.local.

# ── Production resource envelopes (2026-08-24 measured baseline) ─────────────
# Alibaba ECS: 1.64 GiB RAM. Observed steady RSS/working set before limits:
# LiteLLM ~701 MiB, AI ~137 MiB, PostgreSQL ~77 MiB, API ~14 MiB,
# Caddy ~20 MiB, Web ~5 MiB, Redis ~3 MiB. Limits preserve substantial
# headroom above these observations; reservations are soft scheduling signals.
POSTGRES_MEMORY_LIMIT=384m
POSTGRES_MEMORY_RESERVATION=128m
REDIS_MEMORY_LIMIT=96m
REDIS_MEMORY_RESERVATION=16m
LITELLM_MEMORY_LIMIT=1152m
LITELLM_MEMORY_RESERVATION=640m
AI_SERVICE_MEMORY_LIMIT=384m
AI_SERVICE_MEMORY_RESERVATION=160m
API_MEMORY_LIMIT=192m
API_MEMORY_RESERVATION=48m
WEB_MEMORY_LIMIT=96m
WEB_MEMORY_RESERVATION=16m
CADDY_MEMORY_LIMIT=128m
CADDY_MEMORY_RESERVATION=32m

# Host capacity policy. Swap is an OOM shock absorber, not normal working RAM.
CAPACITY_SWAP_GIB=2
CAPACITY_SWAPPINESS=10
CAPACITY_MEMORY_WARN_AVAILABLE_PCT=15
CAPACITY_MEMORY_CRITICAL_AVAILABLE_PCT=8
CAPACITY_SWAP_WARN_USED_PCT=25
CAPACITY_SWAP_CRITICAL_USED_PCT=60
CAPACITY_DISK_WARN_USED_PCT=80
CAPACITY_DISK_CRITICAL_USED_PCT=90
CAPACITY_CONTAINER_MEMORY_WARN_PCT=80
CAPACITY_CONTAINER_MEMORY_CRITICAL_PCT=92
CAPACITY_RETENTION_DAYS=14
CAPACITY_DOCKER_PRUNE_UNTIL=168h
