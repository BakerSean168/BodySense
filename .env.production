# ═══════════════════════════════════════════════════════
# BodySense 生产环境配置 (非敏感)
# =============================================================================
# 本文件包含生产环境的非敏感配置，可以提交到 Git。
# 敏感信息 (密码、密钥) 放在 .env.production.local 中，不提交 Git。
#
# 加载优先级：
#   1. .env (基础共享配置)
#   2. .env.production (本文件 ← 生产非敏感配置)
#   3. .env.production.local (生产敏感信息，不提交 Git)
#   4. 操作系统环境变量 (最高优先级)
# =============================================================================

# ── 应用基础配置 ──────────────────────────────────────
NODE_ENV=production
TZ=Asia/Shanghai

# ── Docker 镜像配置 ────────────────────────────────────
REGISTRY=crpi-cv97phwhms6wy4as.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=bodysense
WEB_TAG=prod-latest
API_TAG=prod-latest
AI_TAG=prod-latest

# ── Caddy / Watchtower ────────────────────────────────
APP_DOMAIN=body.bakersean.top
ACME_EMAIL=admin@bakersean.top
WATCHTOWER_POLL_INTERVAL=300

# ── 数据库配置 (PostgreSQL + pgvector) ───────────────
# DB_PASSWORD 必须在 .env.production.local 中设置！
DB_HOST=postgres                              # Docker 网络中的 PostgreSQL 服务名
DB_PORT=5432
DB_NAME=bodysense
DB_USER=bodysense

# ── Redis 配置 ───────────────────────────────────────
# REDIS_PASSWORD 必须在 .env.production.local 中设置！
REDIS_HOST=redis                              # Docker 网络中的 Redis 服务名
REDIS_PORT=6379

# ── Go API 配置 ──────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
JWT_ACCESS_TTL_HOURS=168                      # Access token 有效期 7 天
JWT_REFRESH_TTL_HOURS=720                     # Refresh token 有效期 30 天
# JWT_SECRET_KEY 必须在 .env.production.local 中设置！
CORS_ORIGINS=https://body.bakersean.top    # 生产环境允许的前端来源

# ── Model Gateway (LiteLLM) ───────────────────────────
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.97.0
LITELLM_PORT=4000
# LITELLM_MASTER_KEY must be set in the untracked production secret env file.

# ── AI Service 配置 (Python/FastAPI) ────────────────
AI_SERVICE_PORT=8100
EMBEDDING_PROVIDER=hashing                    # 默认离线 hashing embedding
EMBEDDING_DIMENSIONS=384
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-120b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY 必须在 .env.production.local 中设置！
# LLM_API_KEY 同 OPENROUTER_API_KEY，在 .env.production.local 中设置
# EMBEDDING_API_KEY 同 OPENROUTER_API_KEY，在 .env.production.local 中设置
WHISPER_MODEL=ggml-base.bin

# ── AI Service URL (Go 后端代理) ─────────────────────
AI_SERVICE_URL=http://ai-service:8100

# ── 前端构建配置 (Vite) ─────────────────────────────
VITE_WS_URL=wss://body.bakersean.top/ws       # WebSocket 地址 (HTTPS 下使用 wss)

# ═══════════════════════════════════════════════════════
# 快速部署检查清单
# ═══════════════════════════════════════════════════════
#
# 1️⃣  在服务器上创建 .env.production.local (敏感信息)：
#
#    cat > /opt/bodysense/.env.production.local << 'EOF'
#    DB_PASSWORD=<生成的强密码>
#    REDIS_PASSWORD=<生成的强密码>
#    JWT_SECRET_KEY=<生成的强密钥>
#    OPENROUTER_API_KEY=sk-or-v1-xxx
#    LLM_API_KEY=sk-or-v1-xxx
#    EMBEDDING_API_KEY=sk-or-v1-xxx
#    EOF
#    chmod 600 /opt/bodysense/.env.production.local
#
# 2️⃣  生成强密钥：openssl rand -base64 32
#
# 3️⃣  启动应用：
#    cd /opt/bodysense
#    docker compose -f docker/docker-compose.prod.yml \
#      --env-file .env.production \
#      --env-file .env.production.local up -d
#
# 4️⃣  检查服务状态：
#    docker compose -f docker/docker-compose.prod.yml ps
#
# 5️⃣  查看日志：
#    docker compose -f docker/docker-compose.prod.yml logs -f api
# ═══════════════════════════════════════════════════════
