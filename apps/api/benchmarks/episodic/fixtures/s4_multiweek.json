    {"id": "note-01", "user": "user-1", "week": 1, "from_seq": 1, "to_seq": 2, "created_at": "2026-01-05T09:00:00Z", "text": "用户提到周末在城南早市买了一束向日葵，摊主还送了两枝满天星。"},
    {"id": "note-02", "user": "user-1", "week": 1, "from_seq": 3, "to_seq": 4, "created_at": "2026-01-05T10:00:00Z", "text": "用户说每周三晚上会去社区泳池游泳，一次大约四十分钟。"},
    {"id": "note-13", "user": "user-1", "week": 2, "from_seq": 5, "to_seq": 6, "created_at": "2026-01-12T09:00:00Z", "text": "用户说周末喜欢去城南的旧货市场闲逛，看看老物件。"},
    {"id": "note-03", "user": "user-1", "week": 2, "from_seq": 7, "to_seq": 8, "created_at": "2026-01-12T10:00:00Z", "text": "用户提到家里的橘猫叫团子，最喜欢趴在窗台晒太阳。"},
    {"id": "note-04", "user": "user-1", "week": 2, "from_seq": 9, "to_seq": 10, "created_at": "2026-01-12T11:00:00Z", "text": "用户说早餐常吃燕麦粥配香蕉，偶尔换成全麦面包。"},
    {"id": "note-05", "user": "user-1", "week": 3, "from_seq": 11, "to_seq": 12, "created_at": "2026-01-19T09:00:00Z", "text": "用户提到在旧书店淘到一本二手摄影画册，封面是雪山。"},
    {"id": "note-06", "user": "user-1", "week": 3, "from_seq": 13, "to_seq": 14, "created_at": "2026-01-19T10:00:00Z", "text": "用户说通勤骑共享单车大约二十分钟，路上会经过一座桥。"},
    {"id": "note-07", "user": "user-1", "week": 4, "from_seq": 15, "to_seq": 16, "created_at": "2026-01-26T09:00:00Z", "text": "用户提到周末和朋友去西山爬山，赶上了日出。"},
    {"id": "note-14", "user": "user-1", "week": 4, "from_seq": 17, "to_seq": 18, "created_at": "2026-01-26T10:00:00Z", "text": "用户提到周末常在家附近的公园慢跑，顺便看看花草。"},
    {"id": "note-08", "user": "user-1", "week": 4, "from_seq": 19, "to_seq": 20, "created_at": "2026-01-26T11:00:00Z", "text": "用户说喜欢在雨天泡一壶热乌龙茶，配一小碟花生。"},
    {"id": "note-09", "user": "user-1", "week": 5, "from_seq": 21, "to_seq": 22, "created_at": "2026-02-02T09:00:00Z", "text": "用户提到最近在学习用胶片相机拍街景。"},
    {"id": "note-10", "user": "user-1", "week": 5, "from_seq": 23, "to_seq": 24, "created_at": "2026-02-02T10:00:00Z", "text": "用户说楼下的桂花开了，晚上散步能闻到香味。"},
    {"id": "note-11", "user": "user-1", "week": 6, "from_seq": 25, "to_seq": 26, "created_at": "2026-02-09T09:00:00Z", "text": "用户提到计划下个月去海边看灯塔。"},
    {"id": "note-12", "user": "user-1", "week": 6, "from_seq": 27, "to_seq": 28, "created_at": "2026-02-09T10:00:00Z", "text": "用户说周末把阳台的旧木桌重新刷了漆。"},
    {"id": "note-15", "user": "user-2", "week": 1, "from_seq": 1, "to_seq": 2, "created_at": "2026-01-05T09:00:00Z", "text": "用户提到在河边公园跟着老师学打太极。"},
    {"id": "note-28", "user": "user-2", "week": 1, "from_seq": 3, "to_seq": 4, "created_at": "2026-01-05T10:00:00Z", "text": "用户说周末会去河边公园喂鸭子。"},
    {"id": "note-16", "user": "user-2", "week": 2, "from_seq": 5, "to_seq": 6, "created_at": "2026-01-12T09:00:00Z", "text": "用户说阳台上种了薄荷和迷迭香，用来做菜。"},
    {"id": "note-23", "user": "user-2", "week": 2, "from_seq": 7, "to_seq": 8, "created_at": "2026-01-12T10:00:00Z", "text": "用户说周末常去河边公园散步，看看河面上的船。"},
    {"id": "note-17", "user": "user-2", "week": 3, "from_seq": 9, "to_seq": 10, "created_at": "2026-01-19T09:00:00Z", "text": "用户提到每周五晚上会看一部老电影。"},
    {"id": "note-24", "user": "user-2", "week": 3, "from_seq": 11, "to_seq": 12, "created_at": "2026-01-19T10:00:00Z", "text": "用户提到周末和老电影俱乐部的朋友聚会。"},
    {"id": "note-18", "user": "user-2", "week": 4, "from_seq": 13, "to_seq": 14, "created_at": "2026-01-26T09:00:00Z", "text": "用户说最近在练吉他弹唱，学会了一首民谣。"},
    {"id": "note-25", "user": "user-2", "week": 4, "from_seq": 15, "to_seq": 16, "created_at": "2026-01-26T10:00:00Z", "text": "用户说周末在家练吉他，录了一小段视频。"},
    {"id": "note-19", "user": "user-2", "week": 5, "from_seq": 17, "to_seq": 18, "created_at": "2026-02-02T09:00:00Z", "text": "用户提到奶奶教他包韭菜鸡蛋饺子。"},
    {"id": "note-26", "user": "user-2", "week": 5, "from_seq": 19, "to_seq": 20, "created_at": "2026-02-02T10:00:00Z", "text": "用户提到周末和奶奶一起包饺子，聊起老家的事。"},
    {"id": "note-20", "user": "user-2", "week": 5, "from_seq": 21, "to_seq": 22, "created_at": "2026-02-02T11:00:00Z", "text": "用户说家里换了一盏暖色的台灯。"},
    {"id": "note-21", "user": "user-2", "week": 6, "from_seq": 23, "to_seq": 24, "created_at": "2026-02-09T09:00:00Z", "text": "用户提到计划秋天去婺源看晒秋。"},
    {"id": "note-27", "user": "user-2", "week": 6, "from_seq": 25, "to_seq": 26, "created_at": "2026-02-09T10:00:00Z", "text": "用户说周末喜欢整理家里的旧物。"},
    {"id": "note-22", "user": "user-2", "week": 6, "from_seq": 27, "to_seq": 28, "created_at": "2026-02-09T11:00:00Z", "text": "用户说周末整理旧照片，找到一张毕业合影。"}
  ],
