{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service",
  "projectType": "application",
  "tags": ["scope:ai", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run uvicorn src.main:app --reload --port 8100"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run pytest"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run pytest --cov=src --cov-report=term-missing"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_consultation_eval.py"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check ."
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check --fix ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff format ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run pyright src"
      }
    },
    "eval:diagnosis": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_eval.py --stdout-only"
      }
    }
  }
}
