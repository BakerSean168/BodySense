{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service",
  "projectType": "application",
  "tags": [
    "scope:ai",
    "type:app"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr uvicorn src.main:app --reload --host 127.0.0.1 --port ${AI_SERVICE_PORT:-20102}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra dev --extra ocr pytest"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra dev --extra ocr pytest --cov=src --cov-report=term-missing"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_consultation_eval.py"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check ."
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check --fix ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff format ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run pyright src"
      }
    },
    "eval:diagnosis": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_eval.py --stdout-only"
      }
    },
    "eval:diagnosis-evidence-policy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_evidence_eval.py"
      }
    },
    "eval:diagnosis-promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_promotion_eval.py"
      }
    },
    "eval:treatment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_eval.py --stdout-only"
      }
    },
    "eval:treatment-evidence-gap": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_evidence_eval.py --stdout-only"
      }
    },
    "eval:treatment-promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_promotion_eval.py"
      }
    },
    "eval:assessment-evidence-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_assessment_evidence_eval.py"
      }
    }
  }
}
