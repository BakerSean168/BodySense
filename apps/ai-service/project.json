{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ai-service",
  "projectType": "application",
  "tags": ["scope:ai", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr --extra pose --extra document-ocr python scripts/ensure_pose_model.py && uv run --extra ocr --extra pose --extra document-ocr python scripts/ensure_health_document_models.py && uv run --extra ocr --extra pose --extra document-ocr uvicorn src.main:app --reload --host 127.0.0.1 --port ${AI_SERVICE_PORT:-20102}"
      }
    },
    "serve-document": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra document-ocr python scripts/ensure_health_document_models.py && uv run --extra document-ocr uvicorn src.document_main:app --reload --host 127.0.0.1 --port ${DOCUMENT_SERVICE_PORT:-20103}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra dev --extra ocr pytest"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/coverage"],
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra dev --extra ocr pytest --cov=src --cov-report=term-missing"
      }
    },
    "eval": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_consultation_eval.py"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check ."
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff check --fix ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run ruff format ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run pyright src"
      }
    },
    "eval:diagnosis": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_eval.py --stdout-only"
      }
    },
    "eval:diagnosis-evidence-policy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_evidence_eval.py"
      }
    },
    "eval:diagnosis-promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_diagnosis_promotion_eval.py"
      }
    },
    "eval:treatment": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_eval.py --stdout-only"
      }
    },
    "eval:treatment-evidence-gap": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_evidence_eval.py --stdout-only"
      }
    },
    "eval:treatment-promotion": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_treatment_promotion_eval.py"
      }
    },
    "eval:assessment-evidence-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/run_assessment_evidence_eval.py"
      }
    },
    "benchmark:health-document:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr python scripts/generate_health_document_synthetic_corpus.py --force"
      }
    },
    "benchmark:health-document:validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr python scripts/validate_health_document_corpus.py"
      }
    },
    "benchmark:health-document:real-layout:status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr python scripts/manage_health_document_real_layout.py status"
      }
    },
    "benchmark:health-document:real-layout:validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr python scripts/manage_health_document_real_layout.py validate"
      }
    },
    "benchmark:health-document:tesseract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr python scripts/benchmark_health_document_candidates.py --candidate tesseract"
      }
    },
    "benchmark:health-document:rapidocr-small-bounded": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr --extra ocr-benchmark python scripts/benchmark_health_document_candidates.py --candidate rapidocr-ppocrv6-small-bounded"
      }
    },
    "benchmark:health-document:rapidocr-tiny": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr --extra ocr-benchmark python scripts/benchmark_health_document_candidates.py --candidate rapidocr-ppocrv6-tiny --execution-topology per-document-subprocess-v1"
      }
    },
    "benchmark:health-document:evaluate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run python scripts/evaluate_health_document_candidate.py --help"
      }
    },
    "benchmark:health-document:rapidocr-medium": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ai-service",
        "command": "uv run --extra ocr --extra ocr-benchmark python scripts/benchmark_health_document_candidates.py --candidate rapidocr-ppocrv6-medium"
      }
    }
  }
}
