      "reviewed_by": "maintainer-evidence-review",
      "review_basis": "Official IASP Terminology defines pain and nociception, states that pain and nociception are different phenomena, states that pain cannot be inferred solely from sensory-neuron activity, and defines nociplastic pain as possible despite no clear evidence of actual or threatened tissue damage. The page directs users to request permission for reuse/reprint, so the review authorizes citation linkage only."
    },
    {
      "canonical_key": "url:ab973d3f9c4bddfe9b6f4dffe11a5162",
      "canonical_url": "https://www.iasp-pain.org/publications/iasp-news/iasp-announces-revised-definition-of-pain/",
      "authority_tier": "B",
      "evidence_level": "professional_definition",
      "license_status": "citation_only",
      "review_status": "reviewed",
      "reviewed_by": "maintainer-evidence-review",
      "review_basis": "Official IASP announcement states the revised pain definition and its six key notes, including personal experience, biopsychosocial influence, the pain/nociception distinction, non-inference from sensory-neuron activity, and respect for a person's report. Citation linkage only; no redistribution permission is asserted."
    }
