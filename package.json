{
  "name": "bodysense",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "bash scripts/dev-interactive.sh all",
    "dev:web": "bash scripts/dev-interactive.sh web",
    "dev:api": "bash scripts/dev-interactive.sh api",
    "dev:ai": "bash scripts/dev-interactive.sh ai",
    "dev:infra:up": "bash scripts/dev-infra.sh up",
    "dev:infra:status": "bash scripts/dev-infra.sh status",
    "dev:infra:logs": "bash scripts/dev-infra.sh logs",
    "dev:infra:down": "bash scripts/dev-infra.sh down",
    "build": "pnpm nx run-many -t build --all --exclude=bodysense",
    "lint": "pnpm nx run-many -t lint --all --parallel=3 --exclude=bodysense",
    "typecheck": "pnpm nx run-many -t typecheck --all --parallel=3 --exclude=bodysense",
    "test": "pnpm nx run-many -t test --all --exclude=bodysense",
    "e2e": "pnpm exec playwright test",
    "verify:release": "bash scripts/validate-repo.sh",
    "validate:local-deploy": "bash scripts/local-deploy-validate.sh",
    "test:watch": "pnpm nx run-many -t test:watch --all --exclude=bodysense",
    "test:coverage": "pnpm nx run-many -t test:coverage --all --exclude=bodysense",
    "affected:build": "pnpm nx affected -t build",
    "affected:test": "pnpm nx affected -t test",
    "affected:lint": "pnpm nx affected -t lint",
    "affected:typecheck": "pnpm nx affected -t typecheck",
    "graph": "pnpm nx graph",
    "clean": "pnpm nx reset",
    "docker:dev:up": "pnpm dev:infra:up",
    "docker:dev:down": "pnpm dev:infra:down",
    "docker:dev:logs": "pnpm dev:infra:logs",
    "docker:prod:up": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local logs -f",
    "docker:prod:ps": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local ps",
    "docker:prod:pull": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local pull",
    "docker:prod:restart": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production --env-file .env.production.local restart",
    "tsc7": "node ./node_modules/typescript7/bin/tsc",
    "static:manifest": "node scripts/static-assets/manifest.mjs",
    "static:publish:web": "node scripts/static-assets/publish-web-r2.mjs",
    "static:publish:atlas": "node scripts/static-assets/publish-atlas-r2.mjs",
    "test:static-assets": "node --test scripts/static-assets/*.test.mjs",
    "test:delivery": "node --test scripts/delivery/*.test.mjs",
    "test:validation-lifecycle": "node --test scripts/validation/*.test.mjs",
    "curriculum:validate": "node scripts/learning/validate-curriculum.mjs && node scripts/learning/validate-placement.mjs",
    "curriculum:status": "node scripts/learning/generate-curriculum-status.mjs && node scripts/learning/generate-prerequisite-spine.mjs && node scripts/learning/generate-curriculum-catalogs.mjs && node scripts/learning/generate-concept-audit.mjs && node scripts/learning/generate-study-tracks.mjs && node scripts/learning/generate-core-subheading-audit.mjs && node scripts/learning/generate-core-prose-risk-audit.mjs && node scripts/learning/generate-placement-status.mjs",
    "curriculum:check": "pnpm curriculum:validate && pnpm curriculum:status",
    "curriculum:refresh-fso-sources": "node scripts/learning/refresh-fso-mooc-index.mjs && node scripts/learning/sync-fso-current-source.mjs && pnpm curriculum:check",
    "curriculum:refresh-fso-core-subheadings": "node scripts/learning/refresh-fso-core-subheadings.mjs",
    "curriculum:refresh-fso-core-prose-risk": "node scripts/learning/refresh-fso-core-prose-risk-audit.mjs",
    "curriculum:placement": "node scripts/learning/generate-placement-status.mjs",
    "curriculum:select-track": "node scripts/learning/select-placement-track.mjs",
    "schema:snapshot": "bash scripts/schema/capture-current.sh",
    "contracts:bootstrap": "bash scripts/contracts/bootstrap-tools.sh",
    "contracts:lint": "bash scripts/contracts/lint.sh",
    "contracts:generate": "bash scripts/contracts/generate.sh",
    "contracts:check-generated": "bash scripts/contracts/check-generated.sh",
    "contracts:breaking": "bash scripts/contracts/breaking.sh",
    "contracts:mutation": "bash scripts/contracts/mutation.sh",
    "contracts:conformance": "bash scripts/contracts/conformance.sh",
    "contracts:verify": "bash scripts/contracts/verify.sh",
    "postman:generate": "node scripts/postman/generate.mjs",
    "postman:verify": "node scripts/postman/generate.mjs --check",
    "postman:validate-native": "bash scripts/postman/validate-native.sh",
    "quality:architecture": "bash scripts/quality/check-architecture.sh",
    "quality:architecture:test": "bash scripts/quality/test-architecture.sh",
    "quality:capacity": "bash scripts/quality/check-validation-capacity.sh",
    "quality:capacity:test": "bash scripts/quality/test-validation-capacity.sh",
    "quality:verify": "pnpm quality:architecture && pnpm quality:architecture:test && pnpm quality:capacity:test"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/vite": "23.1.0",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.51.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "16.0.0",
    "nx": "23.1.0",
    "openapi-to-postmanv2": "6.3.3",
    "orval": "8.30.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.65.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
