  "$defs": {
    "StreamFailureError": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LifestyleContext": {
      "type": "object",
      "required": [
        "section",
        "summary",
        "details"
      ],
      "properties": {
        "section": {
          "type": "string",
          "enum": [
            "activity",
            "sleep",
            "exercise",
            "nutrition",
            "substances",
            "recovery"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      }
    },
    "ExtractedInfo": {
      "type": "object",
      "required": [
        "body_part"
      ],
      "properties": {
        "body_part": {
          "type": "string",
          "minLength": 1
        },
        "symptom_type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "relief": {
          "type": "string"
        },
        "radiation": {
          "type": "string"
        },
        "functional_impact": {
          "type": "string"
        },
        "neurological_signs": {
          "type": "string"
        },
        "onset": {
          "type": "string"
        },
        "additional_notes": {
          "type": "string"
        },
        "capture_id": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "InteractionQuestionField": {
      "type": "object",
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
