                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "reason"
                  ]
                },
                {
                  "properties": {
                    "error": {
                      "$ref": "#/$defs/StreamFailureError"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              ]
            }
          },
          "required": [
            "type",
            "channel",
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "run.cancelled"
            },
            "channel": {
              "const": "run"
            },
            "payload": {
