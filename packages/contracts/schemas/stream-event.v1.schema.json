{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodysense.local/schemas/stream-event.v1.schema.json",
  "title": "BodySense StreamEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
