{
  "name": "@bodysense/contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "pnpm exec vitest run packages/contracts/src/stream-event-parser.test.ts packages/contracts/src/stream-event-schema-parity.test.ts packages/contracts/src/presentation-v2.test.ts packages/contracts/src/presentation-v2-handoff.test.ts",
          "cd apps/api && go test ./internal/dto -count=1 -run 'Fixture|StreamEvent|Schema'"
        ],
        "parallel": false
      },
      "inputs": [
        "unitTest",
        "^production",
        "{workspaceRoot}/apps/api/internal/dto/**/*"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node ./node_modules/typescript7/bin/tsc --noEmit -p packages/contracts/tsconfig.json"
      }
    }
  }
}
