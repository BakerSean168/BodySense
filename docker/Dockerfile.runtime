FROM scratch

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION
LABEL org.opencontainers.image.title="bodysense-runtime" \
      org.opencontainers.image.description="BodySense production runtime configuration bundle" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${VERSION}"

COPY .env.production /runtime/.env.production
COPY docker/docker-compose.prod.yml /runtime/docker/docker-compose.prod.yml
COPY docker/Caddyfile /runtime/docker/Caddyfile
COPY docker/litellm/config.yaml /runtime/docker/litellm/config.yaml
COPY scripts/production-deploy-watch.sh /runtime/scripts/production-deploy-watch.sh
COPY scripts/offhost-s3.py /runtime/scripts/offhost-s3.py
COPY scripts/production-offhost-backup.sh /runtime/scripts/production-offhost-backup.sh
COPY scripts/restore-production-backup.sh /runtime/scripts/restore-production-backup.sh
COPY deploy/systemd/bodysense-offhost-backup.service /runtime/deploy/systemd/bodysense-offhost-backup.service
COPY deploy/systemd/bodysense-offhost-backup.timer /runtime/deploy/systemd/bodysense-offhost-backup.timer
COPY deploy/systemd/bodysense-offhost-freshness.service /runtime/deploy/systemd/bodysense-offhost-freshness.service
COPY deploy/systemd/bodysense-offhost-freshness.timer /runtime/deploy/systemd/bodysense-offhost-freshness.timer
COPY scripts/production-postgres-dr.sh /runtime/scripts/production-postgres-dr.sh
COPY scripts/production-postgres18-reset.sh /runtime/scripts/production-postgres18-reset.sh
COPY scripts/install-production-dr.sh /runtime/scripts/install-production-dr.sh
COPY deploy/systemd/bodysense-postgres-dr-backup.service /runtime/deploy/systemd/bodysense-postgres-dr-backup.service
COPY deploy/systemd/bodysense-postgres-dr-backup.timer /runtime/deploy/systemd/bodysense-postgres-dr-backup.timer
COPY deploy/systemd/bodysense-postgres-dr-restore.service /runtime/deploy/systemd/bodysense-postgres-dr-restore.service
COPY deploy/systemd/bodysense-postgres-dr-restore.timer /runtime/deploy/systemd/bodysense-postgres-dr-restore.timer
COPY deploy/systemd/bodysense-postgres-dr-status.service /runtime/deploy/systemd/bodysense-postgres-dr-status.service
COPY deploy/systemd/bodysense-postgres-dr-status.timer /runtime/deploy/systemd/bodysense-postgres-dr-status.timer
COPY scripts/production-capacity-status.sh /runtime/scripts/production-capacity-status.sh
COPY scripts/install-production-capacity.sh /runtime/scripts/install-production-capacity.sh
COPY deploy/systemd/bodysense-capacity-status.service /runtime/deploy/systemd/bodysense-capacity-status.service
COPY deploy/systemd/bodysense-capacity-status.timer /runtime/deploy/systemd/bodysense-capacity-status.timer
COPY deploy/systemd/bodysense-capacity-cleanup.service /runtime/deploy/systemd/bodysense-capacity-cleanup.service
COPY deploy/systemd/bodysense-capacity-cleanup.timer /runtime/deploy/systemd/bodysense-capacity-cleanup.timer

# Canonical GCP staging is also driven from the exact-SHA runtime artifact. The
# host-only staging secret env is intentionally NOT included here.
COPY docker/docker-compose.staging.yml /runtime/staging/docker/docker-compose.staging.yml
COPY docker/litellm/config.staging.yaml /runtime/staging/docker/litellm/config.staging.yaml
COPY scripts/staging-deploy-watch.sh /runtime/staging/scripts/staging-deploy-watch.sh
COPY scripts/install-staging-deploy-watch.sh /runtime/staging/scripts/install-staging-deploy-watch.sh
COPY deploy/systemd/bodysense-staging-deploy-watch.service /runtime/staging/deploy/systemd/bodysense-staging-deploy-watch.service
COPY deploy/systemd/bodysense-staging-deploy-watch.timer /runtime/staging/deploy/systemd/bodysense-staging-deploy-watch.timer
