# ── Atlas acquisition: immutable Vanatome release ─────────────────────
# Keep this stage independent from application source so the ~92 MiB verified
# atlas layer remains cacheable across ordinary Web code changes.
FROM node:24-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS anatomy-atlas

ARG BODYSENSE_ANATOMY_ATLAS_VERSION=1.4.0
WORKDIR /atlas
COPY scripts/anatomy ./scripts/anatomy
RUN node scripts/anatomy/sync.mjs \
      --version "${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
      --output "/release/${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
    && node scripts/anatomy/verify.mjs \
      --version "${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
      --root "/release/${BODYSENSE_ANATOMY_ATLAS_VERSION}"

# ── Builder: Node 24 + pnpm 11, build Vite app ────────────────────────
FROM node:24-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS builder

ARG BODYSENSE_ANATOMY_ATLAS_VERSION=1.4.0
ARG VITE_BODYSENSE_ANATOMY_CATALOG_URL
ARG VITE_ASSET_BASE
ARG BUNDLE_ANATOMY_ATLAS=true

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@11.27.1 --activate

WORKDIR /app

# Parameterized npm registry. Reproducible/supply-chain-validated builds
# default to the canonical npm registry so release-age metadata is authoritative.
# China-local builds may explicitly override this to https://registry.npmmirror.com.
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN pnpm config set registry ${NPM_REGISTRY}

# Copy workspace root files for pnpm workspace resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/utils/package.json packages/utils/

# Install dependencies (no frozen lockfile — platform-specific bindings differ)
RUN pnpm install --no-frozen-lockfile

# Linux native bindings are already resolved as optional dependencies in the committed lockfile.
# Do not run a best-effort post-install mutation here; a missing binding must fail the build.

# Copy full source
COPY . .

# Keep the verified atlas available to the builder without forcing it into the
# runtime image. Local/same-origin builds retain the historical fallback by
# default; release CDN builds explicitly disable bundling and must provide an
# external catalog URL.
COPY --from=anatomy-atlas /release/ /opt/bodysense-anatomy-release/

# Build the web app (outputs to apps/web/dist/).
# Frontend uses apiUrl('/api/v1/...') with empty base — nginx proxies /api to Go backend.
RUN set -eux; \
    case "${BUNDLE_ANATOMY_ATLAS}" in \
      true) \
        mkdir -p apps/web/public/static/anatomy/vanatome; \
        cp -a /opt/bodysense-anatomy-release/. apps/web/public/static/anatomy/vanatome/ \
        ;; \
      false) \
        test -n "${VITE_BODYSENSE_ANATOMY_CATALOG_URL}" || { \
          echo 'BUNDLE_ANATOMY_ATLAS=false requires VITE_BODYSENSE_ANATOMY_CATALOG_URL' >&2; \
          exit 1; \
        } \
        ;; \
      *) \
        echo "BUNDLE_ANATOMY_ATLAS must be true or false, got: ${BUNDLE_ANATOMY_ATLAS}" >&2; \
        exit 1 \
        ;; \
    esac; \
    cd apps/web; \
    VITE_ASSET_BASE="${VITE_ASSET_BASE:-/}" \
    VITE_BODYSENSE_ANATOMY_CATALOG_URL="${VITE_BODYSENSE_ANATOMY_CATALOG_URL:-/static/anatomy/vanatome/${BODYSENSE_ANATOMY_ATLAS_VERSION}/releases/${BODYSENSE_ANATOMY_ATLAS_VERSION}/catalog.json}" \
    npx vite build

# ── Runtime: nginx serves static files ─────────────────────────────────
FROM nginx:1.30.5-alpine@sha256:bf3201ab56f23e5954646379c775d511fc466e9f11376d9725361064ad07ed35

ARG BUILD_DATE
ARG VCS_REF

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy built static files from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

LABEL org.opencontainers.image.title="bodysense-web" \
      org.opencontainers.image.description="BodySense production web frontend" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
