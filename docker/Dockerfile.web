# ── Builder: Node 24 + pnpm 11, build Vite app ─────────
FROM node:24-slim AS builder

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# Parameterized npm mirror — default is npmmirror for China-based CI,
# override with --build-arg NPM_REGISTRY=https://registry.npmjs.org on GHA runners.
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry ${NPM_REGISTRY}

# Copy workspace root files for pnpm workspace resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/utils/package.json packages/utils/

# Install dependencies (no frozen lockfile — platform-specific bindings differ)
RUN pnpm install --no-frozen-lockfile

# Install the Linux native bindings for the target image architecture. The
# workspace lockfile is also used on Windows, so make the production target
# explicit instead of accidentally baking x64-only bindings into ARM images.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) pnpm add -w @rolldown/binding-linux-x64-gnu @esbuild/linux-x64 lightningcss-linux-x64-gnu --no-save ;; \
      arm64) pnpm add -w @rolldown/binding-linux-arm64-gnu @esbuild/linux-arm64 lightningcss-linux-arm64-gnu --no-save ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac

# Copy full source
COPY . .

# Build the web app (outputs to apps/web/dist/)
# Frontend uses apiUrl('/api/v1/...') with empty base — nginx proxies /api to Go backend.
RUN cd apps/web && npx vite build

# ── Runtime: nginx serves static files ─────────────────
FROM nginx:1.27-alpine

ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="bodysense-web" \
      org.opencontainers.image.description="BodySense production web frontend" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy built static files from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
