# ── Atlas acquisition: immutable Vanatome release ─────────────────────
# Keep this stage independent from application source so the ~92 MiB verified
# atlas layer remains cacheable across ordinary Web code changes.
FROM node:24-slim AS anatomy-atlas

ARG BODYSENSE_ANATOMY_ATLAS_VERSION=1.4.0
WORKDIR /atlas
COPY scripts/anatomy ./scripts/anatomy
RUN node scripts/anatomy/sync.mjs \
      --version "${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
      --output "/release/${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
    && node scripts/anatomy/verify.mjs \
      --version "${BODYSENSE_ANATOMY_ATLAS_VERSION}" \
      --root "/release/${BODYSENSE_ANATOMY_ATLAS_VERSION}"

# ── Builder: Node 24 + pnpm 11, build Vite app ────────────────────────
FROM node:24-slim AS builder

ARG BODYSENSE_ANATOMY_ATLAS_VERSION=1.4.0
ARG VITE_BODYSENSE_ANATOMY_CATALOG_URL

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# Parameterized npm mirror — default is npmmirror for China-based CI,
# override with --build-arg NPM_REGISTRY=https://registry.npmjs.org on GHA runners.
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry ${NPM_REGISTRY}

# Copy workspace root files for pnpm workspace resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY packages/utils/package.json packages/utils/

# Install dependencies (no frozen lockfile — platform-specific bindings differ)
RUN pnpm install --no-frozen-lockfile

# Linux native bindings are already resolved as optional dependencies in the committed lockfile.
# Do not run a best-effort post-install mutation here; a missing binding must fail the build.

# Copy full source
COPY . .

# Add the byte-for-byte verified atlas mirror under a version-scoped,
# same-origin public path. Generated binaries never enter ordinary Git.
COPY --from=anatomy-atlas /release/ apps/web/public/static/anatomy/vanatome/

# Build the web app (outputs to apps/web/dist/)
# Frontend uses apiUrl('/api/v1/...') with empty base — nginx proxies /api to Go backend.
RUN cd apps/web \
    && VITE_BODYSENSE_ANATOMY_CATALOG_URL="${VITE_BODYSENSE_ANATOMY_CATALOG_URL:-/static/anatomy/vanatome/${BODYSENSE_ANATOMY_ATLAS_VERSION}/releases/${BODYSENSE_ANATOMY_ATLAS_VERSION}/catalog.json}" \
       npx vite build

# ── Runtime: nginx serves static files ─────────────────────────────────
FROM nginx:1.27-alpine

ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="bodysense-web" \
      org.opencontainers.image.description="BodySense production web frontend" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy built static files from builder
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
